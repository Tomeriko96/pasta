---
import Base from '../layouts/Base.astro';
import {
  restaurant as r, sections, itemName, formatPrice, homePath,
  restaurantSchema, faqSchema, type Lang,
} from '../lib/site';
import { copy } from '../i18n/copy';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = copy(lang);
const other: Lang = lang === 'en' ? 'nl' : 'en';
const schema = [restaurantSchema(lang, t.schemaDescription), faqSchema(lang, t.faqs)];
---
<Base lang={lang} title={t.title} description={t.description} schema={schema}>
  <nav aria-label={lang === 'nl' ? 'Hoofdmenu' : 'Main'}>
    <a class="brand" href="#top">La Carbonara</a>
    <div class="links">
      <a href="#about">{t.nav.about}</a>
      <a href="#menu">{t.nav.menu}</a>
      <a href="#visit">{t.nav.visit}</a>
      <a class="lang" href={homePath[other]} hreflang={other} lang={other} aria-label={t.nav.switchLabel}>{t.nav.switchShort}</a>
    </div>
  </nav>

  <main id="main" tabindex="-1">

  <header class="hero" id="top">
    <div class="eyebrow">{t.eyebrow}</div>
    <h1>La Carbonara</h1>
    <p class="sub" lang="it">Cucina romana nel cuore di Amsterdam</p>
    <p class="tagline">{t.tagline}</p>
    <div class="buttons">
      <a class="btn btn-primary" href={r.maps.directions}>{t.directions}</a>
      <a class="btn btn-outline" href="#menu">{t.viewMenu}</a>
    </div>
    <p class="note">{t.alcoholFree}</p>
  </header>

  <section class="section" id="about">
    <h2 class="section-title">{t.aboutTitle}</h2>
    <div class="prose">
      {t.about.map((p) => <p>{p}</p>)}
    </div>
  </section>

  <section class="section" id="menu">
    <h2 class="section-title">{t.menuTitle}</h2>
    {sections.map((s) => (
      <div class="menu-section">
        <h3 class="menu-head">{s.title[lang]}</h3>
        {s.items.map((item) => {
          const row = (
            <>
              <div class="item"><span class="item-name">{itemName(item, lang)}</span><span class="dots"></span><span class="item-price">{formatPrice(item.price, lang)}</span></div>
              {item.desc && <p class="desc">{item.desc[lang]}</p>}
            </>
          );
          return item.featured
            ? <div class="featured-item"><span class="featured-label" lang="it">{t.featured}</span>{row}</div>
            : row;
        })}
      </div>
    ))}
  </section>

  <section class="section faq-section" id="faq">
    <h2 class="section-title">{t.faqTitle}</h2>
    <div class="faq">
      {t.faqs.map((f) => (
        <>
          <h3>{f.q}</h3>
          <p>{f.a}</p>
        </>
      ))}
    </div>
  </section>

  <section class="visit section" id="visit">
    <h2 class="section-title">{t.visitTitle}</h2>
    <div class="info">
      <p><strong>{r.name}</strong></p>
      <p><a href={r.maps.place}>{r.address.street}, {r.address.postalCode} {r.address.city}</a></p>
      <p>{t.openDaily}</p>
      <p><a href={`tel:${r.phone.tel}`}>{r.phone.display}</a></p>
      <p>{t.noReservations}</p>
    </div>
    <a class="btn btn-primary" href={r.maps.directions}>{t.directions}</a>
  </section>

  </main>

  <footer>
    <p>{r.name} &middot; {r.address.street}, {r.address.city}</p>
    <p>{t.footerNoReservations}</p>
    <p class="url">lacarbonara.nl</p>
  </footer>
</Base>
