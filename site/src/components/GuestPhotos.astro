---
// Photos guests posted with their Google reviews (permission given).
import { Picture } from 'astro:assets';
import carbonara2 from '../assets/guests/carbonara-2.jpg';
import pomodoro from '../assets/guests/pomodoro.jpg';
import ragu from '../assets/guests/ragu.jpg';
import bruschetta from '../assets/guests/bruschetta.jpg';
import type { Lang } from '../lib/site';
import { copy } from '../i18n/copy';

interface Props { lang: Lang }
const t = copy(Astro.props.lang);
const g = t.guests;
const items = [
  { src: carbonara2, alt: t.photos.carbonara },
  { src: pomodoro, alt: g.pomodoro },
  { src: ragu, alt: g.ragu },
  { src: bruschetta, alt: g.bruschetta },
];
---
<section class="band guests" aria-labelledby="guests-title">
  <div class="wrap">
    <h2 id="guests-title">{g.title}</h2>
    <ul class="guest-grid">
      {items.map((p) => (
        <li>
          <figure>
            <Picture src={p.src} formats={['avif', 'webp']} widths={[320, 560, 800]}
              sizes="(min-width: 960px) 260px, 50vw" alt={p.alt} loading="lazy" />
          </figure>
        </li>
      ))}
    </ul>
  </div>
</section>
