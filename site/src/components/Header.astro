---
import { LANGS, routes, restaurant as r, type Lang, type RouteKey } from '../lib/site';
import { copy } from '../i18n/copy';
import OpenStatus from './OpenStatus.astro';

interface Props { lang: Lang; route: RouteKey | null }
const { lang, route } = Astro.props;
const t = copy(lang);
const nav: RouteKey[] = ['menu', 'visit', 'faq'];
---
<header class="site-top">
<div class="topbar">
  <div class="wrap topbar-inner">
    <OpenStatus lang={lang} />
    <span class="topbar-address">{r.address.street}, {r.address.city}</span>
  </div>
</div>
<div class="site-header">
  <div class="wrap header-inner">
    <a class="brand" href={routes.home[lang]} aria-label={`La Carbonara, ${t.nav.home}`}>La Carbonara</a>
    <nav aria-label={t.nav.label}>
      <ul class="nav">
        {nav.map((k) => (
          <li><a href={routes[k][lang]} aria-current={route === k ? 'page' : undefined}>{t.nav[k]}</a></li>
        ))}
      </ul>
    </nav>
    <details class="langs">
      <summary aria-label={t.langName}><span>{lang.toUpperCase()}</span></summary>
      <ul>
        {LANGS.map((l) => (
          <li><a href={routes[route ?? 'home'][l]} hreflang={l} lang={l} aria-current={l === lang ? 'true' : undefined}>{copy(l).langName}</a></li>
        ))}
      </ul>
    </details>
    <a class="btn btn-red header-cta" href={r.maps.directions}>{t.actions.directions}</a>
  </div>
</div>
</header>
