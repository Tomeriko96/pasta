---
import Base from '../layouts/Base.astro';
import Storefront from '../components/Storefront.astro';
import { restaurant as r, type Lang } from '../lib/site';
import { copy } from '../i18n/copy';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = copy(lang);
const v = t.visit;
---
<Base lang={lang} route="visit" title={v.title} description={v.description}>
  <div class="page-head">
    <div class="wrap">
      <h1>{v.h1}</h1>
    </div>
  </div>
  <div class="wrap visit-grid">
    <div class="visit-photo">
      <Storefront lang={lang} loading="eager" />
    </div>
    <div class="visit-info">
      <section aria-labelledby="hours-title">
        <h2 id="hours-title">{v.hoursTitle}</h2>
        <p>{v.hoursText}</p>
      </section>
      <section aria-labelledby="address-title">
        <h2 id="address-title">{v.addressTitle}</h2>
        <p>{r.address.street}<br>{r.address.postalCode} {r.address.city}</p>
        <p class="buttons">
          <a class="btn btn-green" href={r.maps.directions}>{t.actions.google}</a>
          <a class="btn btn-outline" href={r.maps.apple}>{t.actions.apple}</a>
        </p>
      </section>
      {v.walk.length > 0 && <section aria-labelledby="walk-title">
        <h2 id="walk-title">{v.walkTitle}</h2>
        <table class="walk">
          <tbody>
            {v.walk.map((w) => <tr><th scope="row">{w.place}</th><td>{v.minutes(w.min)}</td></tr>)}
          </tbody>
        </table>
      </section>}
      <section aria-labelledby="coming-title">
        <h2 id="coming-title">{v.comingTitle}</h2>
        <p>{v.comingText}</p>
      </section>
      <section aria-labelledby="delivery-title">
        <h2 id="delivery-title">{v.deliveryTitle}</h2>
        <p>{v.deliveryText}</p>
        <p class="buttons">
          <a class="btn btn-outline" href={r.delivery.uberEats} rel="noopener">{v.deliveryLink}</a>
        </p>
      </section>
      <section aria-labelledby="phone-title">
        <h2 id="phone-title">{v.phoneTitle}</h2>
        <p><a href={r.phone.whatsapp}>{r.phone.display}</a></p>
      </section>
    </div>
  </div>
</Base>
